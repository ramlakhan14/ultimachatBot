FROM node:18-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./

COPY . .

ARG REACT_APP_BASE_URL=http://localhost:3000/
ARG REACT_APP_SELF_HOST=true
ARG REACT_APP_ENCRYPTION_DECRYPTION_KEY=dummy
ARG REACT_APP_GOOGLE_AUTH_ID=dummy
ARG REACT_APP_FIREBASE_API_KEY=dummy
ARG REACT_APP_FIREBASE_AUTH_DOMAIN=localhost
ARG REACT_APP_FIREBASE_PROJECT_ID=local-only
ARG REACT_APP_FIREBASE_STORAGE_BUCKET=local-only
ARG REACT_APP_FIREBASE_MESSAGING_SENDER_ID=000000000000
ARG REACT_APP_FIREBASE_APP_ID=local-only
ARG REACT_APP_FIREBASE_MEASUREMENT_ID=dummy
ARG REACT_APP_FIREBASE_VAPID_KEY=dummy

ENV GENERATE_SOURCEMAP=false
ENV REACT_APP_BASE_URL=$REACT_APP_BASE_URL
ENV REACT_APP_SELF_HOST=$REACT_APP_SELF_HOST
ENV REACT_APP_ENCRYPTION_DECRYPTION_KEY=$REACT_APP_ENCRYPTION_DECRYPTION_KEY
ENV REACT_APP_GOOGLE_AUTH_ID=$REACT_APP_GOOGLE_AUTH_ID
ENV REACT_APP_FIREBASE_API_KEY=$REACT_APP_FIREBASE_API_KEY
ENV REACT_APP_FIREBASE_AUTH_DOMAIN=$REACT_APP_FIREBASE_AUTH_DOMAIN
ENV REACT_APP_FIREBASE_PROJECT_ID=$REACT_APP_FIREBASE_PROJECT_ID
ENV REACT_APP_FIREBASE_STORAGE_BUCKET=$REACT_APP_FIREBASE_STORAGE_BUCKET
ENV REACT_APP_FIREBASE_MESSAGING_SENDER_ID=$REACT_APP_FIREBASE_MESSAGING_SENDER_ID
ENV REACT_APP_FIREBASE_APP_ID=$REACT_APP_FIREBASE_APP_ID
ENV REACT_APP_FIREBASE_MEASUREMENT_ID=$REACT_APP_FIREBASE_MEASUREMENT_ID
ENV REACT_APP_FIREBASE_VAPID_KEY=$REACT_APP_FIREBASE_VAPID_KEY

RUN npm ci --legacy-peer-deps
RUN npm run build

FROM nginx:1-alpine
COPY --from=build /app/build /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80